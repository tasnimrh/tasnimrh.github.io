---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Tells search engines who this page is about and which profiles belong to the same person.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site,
  email: `mailto:${site.email}`,
  image: new URL(site.photo, Astro.site),
  sameAs: [site.linkedin, site.github],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'McGill University' },
    { '@type': 'CollegeOrUniversity', name: 'De Montfort University' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#060708" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <header class="site-head">
      <div class="wrap">
        <a class="home" href="/" aria-label={`${site.name}, home`}>
          <span class="mark" aria-hidden="true">TH</span>
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main">
          <a href="/#work">Work</a>
          <a class="hide-s" href="/#experience">Experience</a>
          <a class="hide-s" href="/#contact">Contact</a>
          <a class="nav-cta" href={site.resume}>Resume <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <span class="mono">© {new Date().getFullYear()} {site.name}</span>
        <span class="foot-links">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={site.resume}>Resume</a>
        </span>
      </div>
    </footer>

    <script>
      // Shared motion. Everything degrades to static, fully visible content without JS or with reduced motion.
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal on scroll: quick (450 ms), staggered by --d.
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if (calm || !('IntersectionObserver' in window)) reveals.forEach((el) => el.classList.add('in'));
      else {
        const io = new IntersectionObserver(
          (es) => es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        reveals.forEach((el) => io.observe(el));
      }

      // 2. Count-up numbers. The final value is already in the HTML.
      const fmt = (v: number, el: HTMLElement) =>
        `${el.dataset.pre ?? ''}${v.toLocaleString('en-US', {
          minimumFractionDigits: Number(el.dataset.dec ?? 0),
          maximumFractionDigits: Number(el.dataset.dec ?? 0),
        })}${el.dataset.suf ?? ''}`;
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      if (!calm) {
        const cio = new IntersectionObserver(
          (es) => es.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            cio.unobserve(el);
            const to = Number(el.dataset.count), dur = 900, t0 = performance.now();
            const step = (now: number) => {
              const k = Math.min(1, (now - t0) / dur);
              el.textContent = fmt(to * (1 - Math.pow(1 - k, 3)), el);
              if (k < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }),
          { threshold: 0.6 },
        );
        counters.forEach((el) => {
          el.textContent = fmt(0, el);
          cio.observe(el);
        });
      }

      // 3. Section labels resolve from scrambled glyphs (350 ms).
      const glyphs = '01<>/_#%=+*';
      const sio = new IntersectionObserver(
        (es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          sio.unobserve(el);
          const final = el.dataset.text!;
          const t0 = performance.now();
          const step = (now: number) => {
            const k = Math.min(1, (now - t0) / 350);
            const n = Math.floor(final.length * k);
            el.textContent = final.slice(0, n) + [...final.slice(n)].map((c) => (c === ' ' ? ' ' : glyphs[(Math.random() * glyphs.length) | 0])).join('');
            if (k < 1) requestAnimationFrame(step);
            else el.textContent = final;
          };
          requestAnimationFrame(step);
        }),
        { threshold: 1 },
      );
      if (!calm) document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
        el.dataset.text = el.textContent ?? '';
        sio.observe(el);
      });

      // 4. Pointer spotlight on cards.
      document.querySelectorAll<HTMLElement>('.spot').forEach((el) => {
        el.addEventListener('pointermove', (ev) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          el.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });

      // 5. Reading progress and the experience line fill, both tied to scroll.
      const bar = document.querySelector<HTMLElement>('.progress');
      const tl = document.querySelector<HTMLElement>('.timeline');
      let ticking = false;
      const onScroll = () => {
        ticking = false;
        const h = document.documentElement;
        bar?.style.setProperty('--p', String(h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight)));
        if (tl) {
          const r = tl.getBoundingClientRect();
          const f = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
          tl.style.setProperty('--fill', String(f));
        }
      };
      addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      }, { passive: true });
      onScroll();

      // 6. Project clips play only while on screen.
      const clips = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      if (calm) clips.forEach((v) => (v.controls = true));
      else {
        const vio = new IntersectionObserver(
          (es) => es.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => (v.controls = true));
            else v.pause();
          }),
          { threshold: 0.3 },
        );
        clips.forEach((v) => vio.observe(v));
      }
    </script>
  </body>
</html>
