---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist.">
  <div class="wrap case-head" style="padding-block:7rem">
    <p class="mono muted">404</p>
    <h1>That page does not exist.</h1>
    <p class="lede">The link may be out of date. Everything on this site is one click from the home page.</p>
    <div class="actions" style="margin-top:2rem"><a class="btn primary" href="/">Go to the home page</a></div>
  </div>
</Base>
