---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Budget from '../../components/Budget.astro';
import OrderField from '../../components/OrderField.astro';
import PulseStream from '../../components/PulseStream.astro';
import RunLog from '../../components/RunLog.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length], i },
  }));
}

const { project: p, next, i } = Astro.props;
---

<Base title={p.title} description={p.summary}>
  <article class="wrap case-page">
    <header class="case-head">
      <a class="back mono" href="/#work">All projects</a>
      <p class="mono muted reveal">{String(i + 1).padStart(2, '0')} / {p.context}, {p.when}</p>
      <h1 class="reveal" style="--d:1">{p.title}</h1>
      <p class="question reveal" style="--d:2">{p.question}</p>
      <p class="lede reveal" style="--d:3">{p.lede}</p>
    </header>

    <dl class="p-metrics wide reveal">
      {
        p.metrics.map((m) => (
          <div>
            <dt class="num">{m.v}</dt>
            <dd>{m.l}</dd>
          </div>
        ))
      }
    </dl>

    {
      p.visual === 'budget' && (
        <section class="case-block reveal">
          <p class="mono label">Watch the model sort real orders</p>
          <OrderField />
        </section>
      )
    }
    {
      p.visual === 'pulse' && (
        <section class="case-block reveal">
          <p class="mono label">Every post, matched and filtered</p>
          <PulseStream />
        </section>
      )
    }

    <section class="case-block reveal">
      <p class="mono label">{p.visual === 'budget' ? 'Try it: move the review budget' : p.visual === 'pipeline' ? 'The verification run' : p.visual === 'pulse' ? 'What the live data broke' : 'The recorded run'}</p>
      {p.visual === 'budget' ? <Budget /> : <RunLog log={p.log} />}
    </section>

    <dl class="facts reveal">
      {
        p.facts.map((f) => (
          <div>
            <dt class="mono">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="case-body">
      <h2 class="reveal">The problem</h2>
      <div class="reveal">{p.problem.map((t) => <p>{t}</p>)}</div>

      <h2 class="reveal">What I did</h2>
      <div class="reveal">
        <ol class="steps">{p.myPart.map((t) => <li>{t}</li>)}</ol>
      </div>

      <h2 class="reveal">Results</h2>
      <div class="reveal">
        <ul class="results">{p.results.map((t) => <li>{t}</li>)}</ul>
      </div>

      <h2 class="reveal">Limits</h2>
      <div class="reveal">{p.limits.map((t) => <p>{t}</p>)}</div>
    </div>

    {
      p.media && (
        <section class="case-block reveal">
          <p class="mono label">{p.visual === 'budget' ? 'From the analysis' : p.visual === 'pipeline' ? 'The evidence' : 'The working app'}</p>
          <Gallery items={p.media} />
        </section>
      )
    }

    <div class="links reveal">
      {
        p.links.map((l, j) => (
          <a class:list={['btn', { primary: j === 0 }]} href={l.href}>
            {l.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>

    <nav class="next" aria-label="More work">
      <a class="mono" href="/#work">All projects</a>
      <a class="nx" href={`/work/${next.slug}/`}>
        <span class="mono muted">Next case</span>
        <strong>{next.title}</strong>
      </a>
    </nav>
  </article>
</Base>
