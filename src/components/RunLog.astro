---
// A recorded run shown as rows that appear in sequence when scrolled into view.
// Defaults to SkillGuard's result for the unsafe test skill; other projects pass their own log.
export type Log = {
  top: [string, string];
  rows: { k: string; v: string; s: string; tone: string }[];
  flow: string[];
  caption: string;
};
const skillguard: Log = {
  top: ['skillguard / recorded run', 'unsafe receipt skill'],
  flow: ['pause', 'sandbox', 'evidence', 'decide'],
  caption: 'The static scanner read the code and passed it. Running it showed what it actually did.',
  rows: [
  { k: 'Static scan, NVIDIA SkillSpector', v: '7 / 100', s: 'rated safe', tone: 'warn' },
  { k: 'Receipt tasks in sandbox', v: '12 / 12', s: 'correct', tone: 'muted' },
  { k: 'Private-file reads attempted', v: '13', s: 'all denied', tone: 'bad' },
  { k: 'Model reviewer', v: 'allow', s: 'overruled', tone: 'warn' },
  { k: 'SkillGuard decision', v: 'blocked', s: 'not installed', tone: 'ok' },
  ],
};
const { log = skillguard } = Astro.props as { log?: Log };
const rows = log.rows;
---

<figure class="runlog" data-runlog>
  <div class="rl-top mono">
    <span>{log.top[0]}</span>
    <span>{log.top[1]}</span>
  </div>
  <ol class="rl-rows">
    {
      rows.map((r, i) => (
        <li class={`tone-${r.tone}`} style={`--i:${i}`}>
          <span class="rl-k">{r.k}</span>
          <span class="rl-dots" aria-hidden="true" />
          <b class="rl-v mono">{r.v}</b>
          <span class="rl-s mono">{r.s}</span>
        </li>
      ))
    }
  </ol>
  <div class="rl-flow mono" aria-hidden="true">
    {log.flow.map((f, i) => (i === 0 ? <span>{f}</span> : <><i></i><span class={i === log.flow.length - 1 ? 'end' : undefined}>{f}</span></>))}
  </div>
  <figcaption>{log.caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-runlog]').forEach((el) => {
    new IntersectionObserver(
      ([e], io) => {
        if (e.isIntersecting) {
          el.classList.add('run');
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    ).observe(el);
  });
</script>
